[sub_resource type="Shader" id="Shader_lantern"]
code = "shader_type canvas_item;
varying vec4 sprite_tint;
void vertex() {
    sprite_tint = COLOR;
}
void fragment() {
    vec4 tex = texture(TEXTURE, UV);
    float grey = dot(tex.rgb, vec3(0.299, 0.587, 0.114));
    COLOR = sprite_tint * vec4(mix(vec3(grey), tex.rgb, 0.35), tex.a);
}
"

